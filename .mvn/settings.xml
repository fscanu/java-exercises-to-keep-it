<?xml version="1.0" encoding="UTF-8"?>
<!-- Project-scoped Maven settings: resolve everything from Maven Central only, so a clone
     builds identically regardless of whatever mirrors or corporate repositories the developer
     happens to have configured globally. Applied automatically via .mvn/maven.config
     (-s .mvn/settings.xml); the global ~/.m2/settings.xml is left untouched. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>central</id>
            <name>Maven Central only</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>
</settings>
